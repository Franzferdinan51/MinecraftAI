{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraftai.local/schemas/overseer-response-1.json",
  "title": "HermesCraft overseer response (v1)",
  "description": "Proposals, research notes, and skill ideas only. No commands, no config changes, no tool calls. Everything becomes a review item or gateway proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "proposals": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "bot", "capability", "args", "reason", "expectedEvidence", "riskTier", "idempotencyKey"],
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "bot": { "type": "string", "maxLength": 32 },
          "capability": { "type": "string", "maxLength": 80 },
          "skill": { "type": "string", "maxLength": 80 },
          "args": { "type": "object", "maxProperties": 12 },
          "reason": { "type": "string", "maxLength": 300 },
          "expectedEvidence": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 80 } },
          "riskTier": { "type": "integer", "minimum": 1, "maximum": 3 },
          "idempotencyKey": { "type": "string", "maxLength": 120 },
          "requiresApproval": { "type": "boolean" }
        }
      }
    },
    "research": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "maxLength": 200 },
          "finding": { "type": "string", "maxLength": 500 },
          "uncertainty": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "skillIdeas": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
